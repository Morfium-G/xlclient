// SXC: the volumetric fog's volume: one thread per froxel column walks its slices from the camera
// out, takes the fog medium at each (the near field's light layer and pools, the haze, broken up by
// drifting noise), and writes what has built up so far: the light scattered toward the camera and the
// transmittance. Every pixel then reads its distance's texel (Fog.frag).
#version 450
#extension GL_GOOGLE_include_directive : require

#include "Fog.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 3, rgba16f) uniform writeonly image3D volume;

// --- value noise ------------------------------------------------------------------------------------
float Hash(vec3 p)
{
    p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float Noise(vec3 x)
{
    vec3 i = floor(x);
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(Hash(i + vec3(0, 0, 0)), Hash(i + vec3(1, 0, 0)), f.x),
                   mix(Hash(i + vec3(0, 1, 0)), Hash(i + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(Hash(i + vec3(0, 0, 1)), Hash(i + vec3(1, 0, 1)), f.x),
                   mix(Hash(i + vec3(0, 1, 1)), Hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

// 0..1, mean ~0.5: two octaves, the second smaller and faster.
float Patches(vec3 world)
{
    vec3 drift = vec3(fp.noise.z, fp.noise.w, 0.0);
    vec3 p = (world - drift) / fp.noise.y * 8.0;
    return 0.65 * Noise(p * vec3(1.0, 1.0, 2.0)) + 0.35 * Noise(p * vec3(2.3, 2.3, 4.0) + vec3(5.2, 1.3, 0.0) - drift.yxz * 0.05);
}

// How much of the near field a world position sees: 1 inside, fading to 0 over the last 8 cells of
// the window (beyond it the texels hold other places).
float FieldReach(vec2 world)
{
    float cells = fp.field.y;
    vec2 cell = world / fp.field.x - fp.field.zw; // 0 .. cells inside the window
    vec2 edge = min(cell, vec2(cells) - cell);
    return clamp(min(edge.x, edge.y) / 8.0, 0.0, 1.0);
}

// Extinction (per yd) of the medium at a world position.
float Density(vec3 world)
{
    float sigma = 0.0;

    if (fp.misc.z > 0.5)
    {
        float reach = FieldReach(world.xy);

        if (reach > 0.0)
        {
            // The textures hold the field toroidally (cell i at i mod size), so repeat addressing
            // finds any cell of the window.
            vec2 uv = world.xy / (fp.field.x * fp.field.y);
            vec4 light = textureLod(fieldLight, uv, 0.0);
            vec4 pool = textureLod(fieldPool, uv, 0.0);

            // The light layer: full at its base, thinning out to nothing at base + thickness.
            if (light.x > 0.0 && light.z > 0.0)
            {
                float h = world.z - light.y;
                float layer = 1.0 - smoothstep(0.0, light.z, max(h, 0.0));
                float patchy = light.w * fp.noise.x;
                float n = Patches(world);
                sigma += light.x * layer * clamp(1.0 - patchy + 2.0 * patchy * n, 0.0, 2.0);
            }

            // Pools: flat-topped, a soft band under the top.
            if (pool.x > 0.0)
            {
                float soft = max(pool.z, 0.05);
                sigma += pool.x * (1.0 - smoothstep(pool.y - soft, pool.y, world.z));
            }

            sigma *= reach;
        }
    }

    // The haze: everywhere, thinning out above its base.
    if (fp.misc.w > 0.0)
    {
        float h = max(world.z - fp.haze.x, 0.0);
        sigma += fp.misc.w * exp(-h / max(fp.haze.y, 1.0));
    }

    return sigma * fp.misc.x;
}

void main()
{
    ivec3 size = imageSize(volume);
    ivec2 column = ivec2(gl_GlobalInvocationID.xy);

    if (column.x >= size.x || column.y >= size.y)
    {
        return;
    }

    // The column's ray: its texel centre across the viewport, as clip x, y (D3D: y up).
    vec2 uv = (vec2(column) + 0.5) / vec2(size.xy);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec3 dir = normalize(Unproject(ndc, 1.0) - Unproject(ndc, 0.0));

    vec3 scattered = vec3(0.0);
    float transmittance = 1.0;
    float from = 0.0;

    for (int k = 0; k < kSlices; k++)
    {
        float to = SliceEdge(float(k + 1));
        float mid = 0.5 * (from + to);
        float sigma = Density(fp.origin.xyz + dir * mid);
        float step = exp(-sigma * (to - from));
        scattered += transmittance * (1.0 - step) * fp.colour.rgb;
        transmittance *= step;
        imageStore(volume, ivec3(column, k), vec4(scattered, transmittance));
        from = to;
    }
}
